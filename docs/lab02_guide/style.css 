/* 1. Global Styles and Reset */
:root {
    --primary-color: #A50034; /* สีหลัก มข. แดงอิฐ */
    --secondary-color: #ffc72a; /* สีรอง มข. เหลืองทอง */
    --text-color: #333;
    --bg-light: #f4f4f4;
    --bg-dark: #fff;
    --box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

* {
    /* Box Model: ใช้ border-box เพื่อให้ padding และ border รวมอยู่ในความกว้าง/สูงที่กำหนด */
    box-sizing: border-box; 
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Sarabun', sans-serif;
    color: var(--text-color);
    background-color: var(--bg-light);
    line-height: 1.6;
    padding-top: 100px; /* เว้นที่ว่างสำหรับ Fixed Header/Nav */
}

a {
    color: var(--primary-color);
    text-decoration: none;
}

a:hover {
    text-decoration: underline;
}

/* 2. Header and Navigation */
header {
    background-color: var(--primary-color);
    color: white;
    padding: 1.5em 10px;
    text-align: center;
    position: fixed; /* Fix Header */
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    box-shadow: var(--box-shadow);
}

header h1 {
    font-size: 1.8em;
    margin-bottom: 5px;
}

nav {
    background-color: var(--secondary-color);
    position: fixed; /* Fix Nav Bar ใต้ Header */
    top: 90px;
    left: 0;
    width: 100%;
    z-index: 990;
    box-shadow: var(--box-shadow);
}

nav ul {
    list-style: none;
    display: flex;
    justify-content: center;
    padding: 10px 0;
}

nav ul li a {
    color: var(--text-color);
    padding: 10px 15px;
    display: block;
    font-weight: bold;
    transition: background-color 0.3s ease;
}

nav ul li a:hover {
    background-color: #ffd86b; /* สีเหลืองอ่อนลง */
    text-decoration: none;
    border-radius: 5px;
}

/* 3. Main Content Layout */
main {
    padding: 20px;
    max-width: 1200px;
    margin: 20px auto; /* จัดกึ่งกลางเนื้อหา */
    background-color: var(--bg-dark);
    border-radius: 8px;
    box-shadow: var(--box-shadow);
}

.place-section {
    padding: 30px 0;
    border-bottom: 1px solid #ddd;
}

.place-section:last-child {
    border-bottom: none;
}

.place-section h2 {
    color: var(--primary-color);
    margin-bottom: 20px;
    border-left: 5px solid var(--secondary-color);
    padding-left: 10px;
}

.place-content p {
    margin-bottom: 20px;
    font-size: 1.1em;
}

/* 4. Image Gallery (Flexbox for Box Model arrangement) */
.image-gallery {
    display: flex;
    gap: 20px;
    margin-top: 20px;
    flex-wrap: wrap; /* ให้ภาพขึ้นบรรทัดใหม่เมื่อหน้าจอเล็ก */
    justify-content: center;
}

.image-gallery figure {
    /* Box Model: กำหนดความกว้าง, margin, padding, border */
    flex: 1; /* กำหนดให้ figure ขยาย/หดตัว */
    min-width: 280px; /* กำหนดขนาดขั้นต่ำก่อนจะขึ้นบรรทัดใหม่ */
    max-width: 45%; 
    border: 1px solid #ccc;
    padding: 10px;
    border-radius: 8px;
    background-color: var(--bg-light);
    box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.05);
}

.image-gallery img {
    width: 100%; /* ทำให้รูปภาพเต็มความกว้างของ figure */
    height: auto;
    display: block;
    border-radius: 5px;
    /* Box Model: การกำหนด margin-bottom เพื่อเว้นระยะจาก caption */
    margin-bottom: 10px; 
}

.image-gallery figcaption {
    text-align: center;
    font-style: italic;
    color: #666;
    font-size: 0.9em;
}

/* 5. Footer */
footer {
    background-color: var(--primary-color);
    color: white;
    text-align: center;
    padding: 1em 0;
    margin-top: 30px;
    font-size: 0.9em;
}

/* 6. Media Queries for Responsiveness */

/* สำหรับหน้าจอขนาดเล็ก (Mobile - น้อยกว่า 768px) */
@media (max-width: 768px) {
    
    /* Responsive Header/Nav Adjustments */
    body {
        padding-top: 150px; /* เพิ่มพื้นที่สำหรับ Header และ Nav ที่ยาวขึ้น */
    }

    header h1 {
        font-size: 1.5em;
    }

    nav {
        top: 80px; /* ปรับตำแหน่ง Nav ใต้ Header ที่เล็กลง */
    }

    nav ul {
        flex-direction: column; /* ให้เมนูซ้อนกันในแนวตั้ง */
        align-items: center;
    }

    nav ul li a {
        padding: 5px 15px;
    }

    /* Responsive Main Content and Gallery Adjustments */
    main {
        padding: 10px;
        margin: 10px auto;
    }

    .place-content p {
        font-size: 1em;
    }

    .image-gallery {
        flex-direction: column; /* ให้ภาพซ้อนกันในแนวตั้ง */
        gap: 15px;
    }

    .image-gallery figure {
        min-width: 100%; /* ให้ figure เต็มความกว้างของ main */
        max-width: 100%;
        padding: 5px;
    }
}

/* สำหรับหน้าจอขนาดกลาง (Tablet - 769px ถึง 1024px) */
@media (min-width: 769px) and (max-width: 1024px) {
    /* ปรับปรุงการแสดงผลเพื่อใช้พื้นที่หน้าจอแท็บเล็ตได้ดีขึ้น */
    main {
        padding: 15px;
    }
    
    .image-gallery figure {
        max-width: 48%; /* ให้ภาพแสดง 2 รูปต่อแถว */
    }
}